# Backend Configuration
APP_NAME="India Weather Map API"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Open-Meteo API (no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

# Cassandra (from existing pipeline)
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=spark_streams
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=cassandra

# MET Norway Weather API (Compact endpoint)
METNO_BASE_URL=https://api.met.no/weatherapi/locationforecast/2.0/compact
METNO_USER_AGENT=WeatherPulse/1.0 (https://github.com/AnuragSingh2101/WeatherPulse; anuragsingh2101@users.noreply.github.com)

# OpenStreetMap Nominatim Geocoding API
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=WeatherPulse/1.0 (https://github.com/AnuragSingh2101/WeatherPulse; anuragsingh2101@users.noreply.github.com)

# Apache Kafka Ingestion
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_WEATHER=weather-events
WEATHER_FETCH_INTERVAL_SECONDS=300

# In-Memory Cache (RFC 7234 HTTP compliant for MET Norway & Nominatim)
CACHE_TTL_CURRENT=600
CACHE_TTL_FORECAST=1800
CACHE_TTL_HISTORICAL=3600
CACHE_TTL_GEOCODE=300

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173